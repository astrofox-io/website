---
import Discord from './icons/Discord.astro';
import Github from './icons/Github.astro';
---

<header class="max-w-6xl mx-auto w-full px-6">
  <div class="flex items-center justify-between py-6">
    <a href="/" class="shrink-0">
      <img src="/images/title.png" class="h-8" alt="Astrofox" />
    </a>
    <nav class="flex items-center gap-5">
      <a href="/docs" class="text-sm text-text-muted hover:text-heading transition-colors">
        Docs
      </a>
      <a href="https://discord.gg/wJ6pyMZ" data-umami-event="discord-button" target="_blank" rel="noopener" class="text-text-muted hover:text-heading transition-colors">
        <Discord class="w-5 h-5 fill-current" />
      </a>
      <a href="https://github.com/astrofox-io/astrofox" data-umami-event="github-button" target="_blank" rel="noopener" class="text-text-muted hover:text-heading transition-colors">
        <Github class="w-5 h-5 fill-current" />
      </a>
    </nav>
  </div>
</header>
