---
interface Props {
  href: string;
  id?: string;
  'data-umami-event'?: string;
  target?: string;
  rel?: string;
  class?: string;
}

const { href, class: className = '', ...rest } = Astro.props;
---

<a
  href={href}
  class:list={['inline-flex items-center gap-2 font-medium text-heading bg-accent-dark rounded-lg hover:bg-accent transition-colors', className]}
  {...rest}
>
  <slot />
</a>
