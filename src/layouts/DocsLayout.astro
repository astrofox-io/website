---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '');

const sections = [
  {
    label: 'Introduction',
    items: [
      { href: '/docs', label: 'Overview' },
      { href: '/docs/interface', label: 'Interface tour' },
      { href: '/docs/quick-start', label: 'Quick start' },
    ],
  },
  {
    label: 'Basics',
    items: [
      { href: '/docs/projects', label: 'Projects' },
      { href: '/docs/audio', label: 'Audio' },
      { href: '/docs/scenes', label: 'Scenes & layers' },
      { href: '/docs/stage', label: 'Stage' },
    ],
  },
  {
    label: 'Building visuals',
    items: [
      { href: '/docs/displays', label: 'Displays' },
      { href: '/docs/effects', label: 'Effects' },
      { href: '/docs/reactors', label: 'Reactors' },
    ],
  },
  {
    label: 'Output',
    items: [
      { href: '/docs/exporting', label: 'Exporting' },
    ],
  },
  {
    label: 'Help',
    items: [
      { href: '/docs/tips', label: 'Tips & troubleshooting' },
      { href: '/docs/reference', label: 'Reference' },
    ],
  },
];

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '');
  return pathname === normalized;
}
---

<Layout title={title}>
  <div class="flex flex-col lg:flex-row gap-10 py-10">
    <aside class="lg:w-60 lg:shrink-0">
      <nav class="lg:sticky lg:top-6">
        {sections.map((section) => (
          <div class="mb-6">
            <div class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-3">
              {section.label}
            </div>
            <ul class="space-y-1">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'block text-sm py-1.5 px-3 rounded-md transition-colors',
                      isActive(item.href)
                        ? 'bg-accent/15 text-heading font-medium'
                        : 'text-text hover:text-heading hover:bg-dark-card',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <article class="flex-1 min-w-0 docs-content">
      <header class="mb-8 pb-6 border-b border-border">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-heading">
          {title}
        </h1>
        {description && (
          <p class="mt-3 text-lg text-text-muted">{description}</p>
        )}
      </header>
      <div class="max-w-3xl">
        <slot />
      </div>
    </article>
  </div>
</Layout>

<style is:global>
  .docs-content h2 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-heading);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .docs-content h2:first-child {
    margin-top: 0;
  }
  .docs-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-heading);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }
  .docs-content p {
    margin-bottom: 1rem;
    line-height: 1.75;
  }
  .docs-content ul,
  .docs-content ol {
    margin-bottom: 1rem;
    padding-left: 1.25rem;
    line-height: 1.75;
  }
  .docs-content ul {
    list-style: disc;
  }
  .docs-content ol {
    list-style: decimal;
  }
  .docs-content li {
    margin-bottom: 0.25rem;
  }
  .docs-content li::marker {
    color: var(--color-text-muted);
  }
  .docs-content a {
    color: var(--color-accent);
    transition: color 0.15s;
  }
  .docs-content a:hover {
    color: var(--color-heading);
  }
  .docs-content code {
    background: var(--color-dark-card);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1rem 0.35rem;
    font-size: 0.875em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: var(--color-heading);
  }
  .docs-content figure {
    margin: 1.5rem 0;
  }
  .docs-content figure img {
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    display: block;
  }
  .docs-content figcaption {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
  }
  .docs-content .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 180px;
    border: 1px dashed var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-dark-card);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    padding: 1rem;
    text-align: center;
  }
  .docs-content .callout {
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-dark-card);
    padding: 0.875rem 1rem;
    border-radius: 0.375rem;
    margin: 1rem 0;
    font-size: 0.9375rem;
  }
  .docs-content .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 1.25rem;
    padding: 0;
    list-style: none;
  }
  .docs-content .pill-list li {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--color-heading);
    background: var(--color-dark-card);
  }
</style>
